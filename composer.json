{
    "name": "laracomposer/rumaxbot",
    "description": "RuMaxBot — интеграция Laravel 12 с API rumaxbot.ru. Artisan-команда rumaxbot:test для живой проверки, PHPUnit-тесты клиента и команды.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Goncharov Stepan",
            "email": "in001@z1q.ru",
            "homepage": "https://wwsite.ru"
        }
    ],
    "homepage": "https://github.com/ww-site/RuMaxBot",
    "support": {
        "issues": "https://github.com/ww-site/RuMaxBot/issues",
        "source": "https://github.com/ww-site/RuMaxBot"
    },
    "keywords": [
        "laravel",
        "max",
        "messenger",
        "rumaxbot",
        "bot",
        "notifications"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "RuMaxBot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RuMaxBot\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RuMaxBot\\RuMaxBotServiceProvider"
            ],
            "aliases": {
                "RuMaxBot": "RuMaxBot\\Facades\\RuMaxBot"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
